{
  "qualification-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": ".agents/scripts/qualification_gate.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "closure-stop-gate": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".agents/scripts/closure_stop_gate.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}