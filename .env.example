# builder-II generic target/config vocabulary
BUILDER_TARGET_REPO=../core
BUILDER_TARGET_PROFILE=core
BUILDER_ARTIFACT_ROOT=.builder/artifacts
BUILDER_RUNTIME_MODE=passive

# Backend: mlx-lm | rapid-mlx | ollama
# For MacBook Pro M1 16GB, mlx-lm is the default because it runs Hugging Face
# MLX conversions directly and keeps model aliases exact.
BUILDER_MODEL_BACKEND=mlx-lm

# Model tier remains for compatibility with older routing scripts.
# fast    -> phi-reasoning
# primary -> qwen-coder
BUILDER_MODEL_TIER=primary

# First-class model alias. Recommended defaults:
#   phi-reasoning  : fast logic/review/refusal lane, tiny footprint
#   qwen-coder     : default implementation lane, code-specialized 7B
# Alternates/candidates:
#   gemma-fast, gemma-primary, llama, codegeex, qwen-coder-14b,
#   qwen3-coder-heavy, deepseek
BUILDER_MODEL_ALIAS=qwen-coder

# Runtime endpoint metadata for legacy operator-managed model helpers.
BUILDER_MODEL_BASE_URL=http://127.0.0.1:8080/v1
BUILDER_MODEL_HOST=127.0.0.1
BUILDER_MODEL_PORT=8080
BUILDER_MODEL_TEMPERATURE=0.0

# Rapid-MLX aliases (legacy rapid-mlx backend only)
BUILDER_MODEL_PRIMARY=gemma-4-12b-4bit
BUILDER_MODEL_FAST=gemma-4-e4b-4bit

# mlx-lm Hugging Face repos. Override these when testing newer MLX conversions.
BUILDER_MLX_MODEL_PHI=mlx-community/Phi-4-mini-reasoning-4bit
BUILDER_MLX_MODEL_QWEN=mlx-community/Qwen2.5-Coder-7B-Instruct-4bit
BUILDER_MLX_MODEL_FAST=mlx-community/gemma-4-e4b-it-4bit
BUILDER_MLX_MODEL_PRIMARY=mlx-community/gemma-4-12B-it-4bit
BUILDER_MLX_MODEL_LLAMA=mlx-community/Meta-Llama-3.1-8B-Instruct-4bit

# Candidate/heavy opt-in lanes. These are not safe defaults for M1 16GB.
# If an MLX community repo has been renamed, override the value here before pull.
BUILDER_MLX_MODEL_CODEGEEX=mlx-community/codegeex4-all-9b-4bit
BUILDER_MLX_MODEL_QWEN14=mlx-community/Qwen2.5-Coder-14B-Instruct-4bit
BUILDER_MLX_MODEL_QWEN3_CODER=mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit
BUILDER_MLX_MODEL_DEEPSEEK=mlx-community/DeepSeek-Coder-V2-Lite-Instruct-4bit

# Legacy aliases remain backwards-compatible inputs only. Prefer BUILDER_*.
# CORE_REPO_PATH=../core
# CORE_AGENT_BACKEND=mlx-lm
# CORE_AGENT_MODEL_TIER=primary
# CORE_AGENT_MODEL_ALIAS=qwen-coder
# CORE_AGENT_BASE_URL=http://127.0.0.1:8080/v1
# CORE_AGENT_TEMPERATURE=0.0
