$stratum-pass: #3fb950;
$stratum-warn: #d29922;
$stratum-fail: #f85149;
$stratum-hint: #8b949e;
$stratum-active: #58a6ff;
$stratum-dim: #484f58;
$stratum-bold: #c9d1d9;
$stratum-accent: #d2a8ff;
$stratum-bg: #0a0e14;
$stratum-panel: #0d1117;
$stratum-border: #21262d;
$stratum-panel-light: #161b22;
$stratum-selected: #1f2937;
$stratum-hover: #1c2333;
$stratum-brand: #79c0ff;
$stratum-model: #7ee787;
$stratum-tier: #ffa657;
$stratum-session: #6e7681;
$stratum-selected-text: #f0f6fc;
$stratum-disabled: #30363d;

/* ═══════════════════════════════════════════════════════════════
   STRATUM — The Builder-II TUI Stylesheet
   Operator-grade. Dark. High-contrast. Alive.
   ═══════════════════════════════════════════════════════════════ */

/* ─── Root & Global ────────────────────────────────────── */

Screen {
    background: $stratum-bg;
    color: #c5c8c6;
}

/* ─── Header Bar (The Stratum Banner) ──────────────────── */

#stratum-header {
    dock: top;
    height: 2;
    background: $stratum-panel;
    color: $stratum-hint;
    border-bottom: solid $stratum-border;
    padding: 0 1;
}

#stratum-header .header-primary {
    color: $stratum-active;
    text-style: bold;
}

#stratum-header .header-session {
    color: $stratum-session;
}

HeaderBanner {
    dock: top;
    height: 2;
    background: $stratum-panel;
    color: $stratum-hint;
    border-bottom: solid $stratum-border;
    padding: 0 1;
}

HeaderBanner .banner-brand {
    color: $stratum-brand;
    text-style: bold;
}

HeaderBanner .banner-target {
    color: $stratum-accent;
}

HeaderBanner .banner-model {
    color: $stratum-model;
}

HeaderBanner .banner-tier {
    color: $stratum-tier;
    text-style: bold;
}

HeaderBanner .banner-dim {
    color: $stratum-dim;
}

HeaderBanner .banner-session {
    color: $stratum-session;
}

HeaderBanner .banner-time {
    color: $stratum-dim;
}


/* ─── Main Layout (3-Column Spatial Governance) ───────── */

#main-layout {
    layout: horizontal;
    height: 1fr;
}

/* ─── Left Column: Artifact Spine ─────────────────────── */

#spine-container {
    width: 22;
    min-width: 18;
    max-width: 28;
    background: $stratum-panel;
    border-right: solid $stratum-border;
    padding: 0;
}

#spine-title {
    height: 1;
    background: $stratum-panel-light;
    color: $stratum-hint;
    text-style: bold;
    text-align: center;
    padding: 0 1;
    border-bottom: solid $stratum-border;
}

#spine-list {
    height: 1fr;
    padding: 0;
    scrollbar-size: 1 1;
}

#spine-search {
    height: 3;
    border: tall $stratum-border;
    margin: 0;
    background: $stratum-panel;
    color: $stratum-bold;
}

#spine-search:focus {
    border: tall $stratum-active;
}

.spine-item {
    height: 1;
    padding: 0 1;
}

.spine-item:hover {
    background: $stratum-panel-light;
}

.spine-item.-selected {
    background: $stratum-selected;
    color: $stratum-selected-text;
}

.spine-item.-active {
    background: $stratum-hover;
}

/* Artifact status glyphs */
.artifact-verified {
    color: $stratum-pass;
}

.artifact-gate {
    color: $stratum-warn;
    text-style: bold;
}

.artifact-pending {
    color: $stratum-dim;
}

.artifact-failed {
    color: $stratum-fail;
    text-style: bold;
}

.artifact-disabled {
    color: $stratum-disabled;
}


/* ─── Center Column: The Active Stratum ──────────────── */

#stratum-center {
    width: 1fr;
    min-width: 40;
    background: $stratum-bg;
    padding: 0;
}

#stratum-title-bar {
    height: 1;
    background: $stratum-panel-light;
    color: $stratum-bold;
    text-style: bold;
    text-align: center;
    padding: 0 1;
    border-bottom: solid $stratum-border;
}

/* The morphing content area */
#stratum-content {
    height: 1fr;
    padding: 1 2;
    scrollbar-size: 1 1;
}

/* Chain status footer inside the stratum */
#stratum-chain-bar {
    height: 3;
    background: $stratum-panel;
    border-top: solid $stratum-border;
    padding: 0 2;
    color: $stratum-session;
}

.chain-label {
    color: $stratum-dim;
}

.chain-value {
    color: $stratum-hint;
}

.chain-value-false {
    color: $stratum-pass;
}

.chain-value-true {
    color: $stratum-fail;
    text-style: bold;
}


/* ─── HITL Gate Panel (Ceremony Mode) ────────────────── */

.hitl-gate-panel {
    background: $stratum-panel;
    border: solid $stratum-warn;
    padding: 1 2;
    margin: 1 2;
}

.hitl-gate-panel .gate-header {
    color: $stratum-warn;
    text-style: bold;
    text-align: center;
}

.hitl-gate-panel .gate-cmd {
    color: $stratum-brand;
}

.hitl-gate-panel .gate-tier {
    color: $stratum-accent;
}

.hitl-gate-panel .gate-authority {
    color: $stratum-tier;
}

.hitl-gate-panel .gate-digest {
    color: $stratum-session;
}

.hitl-gate-panel .gate-actions {
    margin-top: 1;
    text-align: center;
}

.hitl-action-approve {
    color: $stratum-pass;
    text-style: bold;
}

.hitl-action-reject {
    color: $stratum-fail;
    text-style: bold;
}

.hitl-action-inspect {
    color: $stratum-active;
}

.hitl-action-diff {
    color: $stratum-accent;
}


/* ─── Right Column: Signal Rail ──────────────────────── */

#signal-rail {
    width: 34;
    min-width: 28;
    max-width: 40;
    background: $stratum-panel;
    border-left: solid $stratum-border;
    padding: 0;
}

/* HITL Gate Indicator */
#hitl-gate-indicator {
    height: 3;
    background: $stratum-panel-light;
    border-bottom: solid $stratum-border;
    padding: 0 1;
    text-align: center;
}

.gate-open {
    color: $stratum-warn;
    text-style: bold;
}

.gate-closed {
    color: $stratum-pass;
}

/* Event Ledger */
#ledger-section {
    height: 1fr;
    border-bottom: solid $stratum-border;
    padding: 0;
}

#ledger-title {
    height: 1;
    background: $stratum-panel-light;
    color: $stratum-hint;
    text-style: bold;
    text-align: center;
    padding: 0 1;
    border-bottom: solid $stratum-border;
}

#ledger-log {
    height: 1fr;
    padding: 0 1;
    scrollbar-size: 1 1;
}

.ledger-timestamp {
    color: $stratum-dim;
}

.ledger-event-pass {
    color: $stratum-pass;
}

.ledger-event-fail {
    color: $stratum-fail;
}

.ledger-event-gate {
    color: $stratum-warn;
}

.ledger-event-info {
    color: $stratum-hint;
}


/* Capability Rail */
#capability-section {
    height: auto;
    max-height: 12;
    padding: 0;
}

#capability-title {
    height: 1;
    background: $stratum-panel-light;
    color: $stratum-hint;
    text-style: bold;
    text-align: center;
    padding: 0 1;
    border-bottom: solid $stratum-border;
}

#capability-list {
    padding: 0 1;
}

.cap-active {
    color: $stratum-pass;
    text-style: bold;
}

.cap-disabled {
    color: $stratum-fail;
}

.cap-blocked {
    color: $stratum-warn;
}


/* ─── Footer (Command Bar) ───────────────────────────── */

#command-footer {
    dock: bottom;
    height: 1;
    background: $stratum-panel-light;
    color: $stratum-hint;
    border-top: solid $stratum-border;
    padding: 0 1;
}

.footer-key {
    color: $stratum-active;
    text-style: bold;
}

.footer-action {
    color: $stratum-session;
}


/* ─── Command Palette Modal ──────────────────────────── */

CommandPaletteScreen {
    align: center middle;
}

#palette-container {
    width: 72;
    max-width: 90%;
    height: 28;
    max-height: 80%;
    background: $stratum-panel-light;
    border: solid $stratum-disabled;
    padding: 0;
}

#palette-title {
    height: 1;
    background: $stratum-border;
    color: $stratum-bold;
    text-style: bold;
    text-align: center;
    padding: 0 1;
}

#palette-search {
    margin: 1 1 0 1;
}

#palette-search Input {
    background: $stratum-panel;
    color: $stratum-bold;
    border: solid $stratum-disabled;
}

#palette-results {
    height: 1fr;
    padding: 0 1;
    scrollbar-size: 1 1;
    margin: 1 0;
}

.palette-item {
    height: 2;
    padding: 0 1;
}

.palette-item:hover {
    background: $stratum-selected;
}

.palette-item.-highlight {
    background: $stratum-hover;
}

.palette-cmd {
    color: $stratum-brand;
}

.palette-tier {
    color: $stratum-accent;
}

.palette-blocked {
    color: $stratum-dim;
}

.palette-authority-flag {
    color: $stratum-tier;
    text-style: bold;
}


/* ─── Raw CLI Passthrough Modal ──────────────────────── */

CLIPassthroughScreen {
    align: center bottom;
}

#cli-container {
    width: 90%;
    height: auto;
    background: $stratum-panel-light;
    border: solid $stratum-disabled;
    padding: 1 2;
}

#cli-prefix {
    color: $stratum-pass;
    text-style: bold;
}

#cli-input {
    background: $stratum-panel;
    color: $stratum-bold;
    border: solid $stratum-disabled;
}

#cli-hint {
    color: $stratum-dim;
    text-align: right;
}


/* ─── Memory Atom Browser ────────────────────────────── */

#memory-browser {
    padding: 0;
}

.memory-atom {
    height: 2;
    padding: 0 1;
}

.memory-atom:hover {
    background: $stratum-panel-light;
}

.memory-type {
    color: $stratum-accent;
}

.memory-score {
    color: $stratum-tier;
}

.memory-content-preview {
    color: $stratum-hint;
}

.memory-pinned {
    color: $stratum-pass;
    text-style: bold;
}


/* ─── Idle Report / Status ───────────────────────────── */

.status-section-title {
    color: $stratum-active;
    text-style: bold;
    margin-bottom: 1;
}

.status-matrix-row {
    height: 1;
}

.status-label {
    color: $stratum-hint;
    width: 20;
}

.status-value-ok {
    color: $stratum-pass;
}

.status-value-warn {
    color: $stratum-warn;
}

.status-value-fail {
    color: $stratum-fail;
}


/* ─── Confirm Modal ──────────────────────────────────── */

ConfirmScreen {
    align: center middle;
}

#confirm-dialog {
    width: 50;
    height: 8;
    background: $stratum-panel-light;
    border: solid $stratum-warn;
    padding: 1 2;
}

#confirm-title {
    color: $stratum-warn;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#confirm-body {
    color: $stratum-bold;
    text-align: center;
    margin-bottom: 1;
}

#confirm-hint {
    color: $stratum-dim;
    text-align: center;
}


/* ─── Reject Annotation Modal ────────────────────────── */

RejectScreen {
    align: center middle;
}

#reject-dialog {
    width: 60;
    height: 12;
    background: $stratum-panel-light;
    border: solid $stratum-fail;
    padding: 1 2;
}

#reject-title {
    color: $stratum-fail;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#reject-input {
    background: $stratum-panel;
    color: $stratum-bold;
    border: solid $stratum-disabled;
    height: 5;
}

#reject-hint {
    color: $stratum-dim;
    text-align: center;
    margin-top: 1;
}


/* ─── Diff View ──────────────────────────────────────── */

.diff-add {
    color: $stratum-pass;
    background: #0d2818;
}

.diff-remove {
    color: $stratum-fail;
    background: #3d0c0c;
}

.diff-header {
    color: $stratum-brand;
    text-style: bold;
}

.diff-context {
    color: $stratum-hint;
}


/* ─── Scrollbar Theming ──────────────────────────────── */

* {
    scrollbar-background: $stratum-bg;
    scrollbar-color: $stratum-border;
    scrollbar-color-hover: $stratum-disabled;
    scrollbar-color-active: $stratum-dim;
}


/* ─── Animations & Pulse ─────────────────────────────── */
/* (Animations removed for CSS parser compatibility) */


/* Removed .cap-just-activated */

/* ─── Masterpiece Widgets ────────────────────────────── */

#epistemic-matrix {
    height: 4;
    margin: 1 2;
    padding: 0;
}

#mechanical-sympathy {
    height: 1;
    background: $stratum-panel;
    border-top: solid $stratum-border;
    padding: 0 1;
}

#mech-icon {
    width: 3;
}

#mech-mem {
    width: 15;
    color: $stratum-hint;
}

#mech-tok {
    width: 15;
    color: $stratum-hint;
}

#third-door-gate {
    margin: 1 2;
    padding: 1 2;
    background: $stratum-panel;
    border: solid $stratum-pass;
}

