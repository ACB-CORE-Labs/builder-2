[0.013, "o", "\r\n\u001b[1mNow we cheat: erase the mutation evidence from a receipt.\u001b[0m\r\n"]
[0.000, "o", "\r\n\u001b[1;36m$ python3 -c \r\nimport json\r\np = '/var/folders/kg/5xbm28qd7jl55j7lv3p001f40000gn/T//builder-ii-recording/demo-out/post-apply-verification-receipt.json'\r\nd = json.load(open(p))\r\nd['workspace_mutation_detected'] = False\r\nd['status_lines'] = []\r\njson.dump(d, open(p, 'w'), indent=2, sort_keys=True)\r\nprint('receipt edited: mutation evidence erased')\r\n\u001b[0m\r\n"]
[0.027, "o", "receipt edited: mutation evidence erased\r\n"]
[0.003, "o", "\r\n\u001b[1;36m$ uv run builder-platform validate-demo-loop /var/folders/kg/5xbm28qd7jl55j7lv3p001f40000gn/T//builder-ii-recording/demo-out/demo-loop-report.json\u001b[0m\r\n"]
[0.212, "o", "\u001b[31mdemo report validation error:\u001b[0m evidence artifact content does not match its recorded sha256: \r\n\u001b[35m/private/var/folders/kg/5xbm28qd7jl55j7lv3p001f40000gn/T/builder-ii-recording/demo-out/\u001b[0m\u001b[95mpost-apply-verification-receipt.j\u001b[0m\r\n\u001b[95mson\u001b[0m\r\n"]
[0.026, "o", "\u001b[1;33m(refused, as designed)\u001b[0m\r\n\r\n\u001b[1mSecond twist: re-point the approval at a different patch digest.\u001b[0m\r\n"]
[0.000, "o", "\r\n\u001b[1;36m$ python3 -c \r\nimport json\r\np = '/var/folders/kg/5xbm28qd7jl55j7lv3p001f40000gn/T//builder-ii-recording/demo-out/hitl-patch-approval.json'\r\nd = json.load(open(p))\r\ndigest = d['patch_digest']\r\nd['patch_digest'] = ('0' if digest[0] != '0' else '1') + digest[1:]\r\n"]
[0.000, "o", "json.dump(d, open(p, 'w'), indent=2, sort_keys=True)\r\nprint('approval retargeted at a patch that was never approved')\r\n\u001b[0m\r\n"]
[0.027, "o", "approval retargeted at a patch that was never approved\r\n"]
